# VeeGo Passenger App — environment variables
# Copy to .env and fill in values. (.env is gitignored.)
#
# Note: on Replit, scripts/setup.sh generates .env automatically from the
# BACKEND_URL secret; you only need this file for manual/local setup.

# Backend API base URL (also used to derive the Socket.IO host).
# Read at runtime by src/api/client.ts, src/api/socket.ts,
# src/api/shuttleService.ts.
EXPO_PUBLIC_API_URL=

# Google Maps SDK keys for native map rendering (read at build time by
# app.config.ts). Directions API calls are proxied through the backend,
# so no other Maps key is needed at runtime.
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=
